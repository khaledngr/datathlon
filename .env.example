# Datathlon settings. Copy to .env and fill in YOUR values: cp .env.example .env
# .env is NOT committed (.gitignore). Never put a password or a key itself here: only paths to files.
# Values left empty are personal; values filled in are the same for the whole team.

# --- Snowflake (account NVTLKDO-RP44213, GCP Frankfurt) -------------------------------
SNOWFLAKE_ACCOUNT=NVTLKDO-RP44213
SNOWFLAKE_USER=
# Absolute path to YOUR private key (rsa_key.p8), stored outside the repo. Created with TD 2 gen_key.py.
SNOWFLAKE_PRIVATE_KEY_PATH=
# Temporary: SYSADMIN until step 3 creates DATATHLON_ENGINEER (decision D-027)
SNOWFLAKE_ROLE=SYSADMIN
# Service user the pipeline scripts run as (step 5, Terraform). Its private key: ask Khaled, never by chat/Git
PIPELINE_USER=DATATHLON_PIPELINE
PIPELINE_PRIVATE_KEY_PATH=
# Created in step 3 (Terraform)
SNOWFLAKE_WAREHOUSE=DATATHLON_WH
SNOWFLAKE_DATABASE=DATATHLON

# --- Google Cloud (project datathlon-513514) -----------------------------------------
GCP_PROJECT_ID=datathlon-513514
GCP_REGION=europe-west3
# Created in step 3 (Terraform)
GCS_LANDING_BUCKET=datathlon-landing-513514

# --- Local Postgres: the simulated web shop database (step 4, runs in Docker) ---------
PGHOST=localhost
PGPORT=5433
PGDATABASE=datathlon_web
PGUSER=datathlon
# Local Docker database only, not a real secret, but still kept out of Git
PGPASSWORD=
